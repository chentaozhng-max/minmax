// PsyMatch 数据模型
// 说明：本地开发使用 SQLite（零安装）。SQLite 下 Prisma 不支持 enum / Json，
// 因此「枚举字段」一律以 String 存储，取值约束由 src/lib/domain.ts 中的常量 + Zod 保证；
// 「Json 字段」以 JSON 字符串存储，读写走 src/lib/domain.ts 的 helpers。
// 迁移到 PostgreSQL 时只需把 provider 改为 "postgresql" 并改 DATABASE_URL，
// 字段名与结构完全一致（见 DECISIONS.md）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(cuid())
  phone    String  @unique
  role     String  @default("SUBJECT") // Role
  name     String
  school   String?
  department String?
  avatarUrl String?

  // 学生认证
  studentVerified Boolean   @default(false)
  studentId       String?
  eduEmail        String?
  verifiedAt      DateTime?

  // 资料完善（首次进入的引导，对应招聘类 App 的"完善资料"流程）
  profileCompleted Boolean @default(false)
  grade            String? // 被试：年级
  interests        String? // 感兴趣的研究方向，逗号分隔
  timePreference   String? // 常有空的时间段，逗号分隔

  // 信誉分（被试与主试共用，按 role 解释）
  creditScore Int       @default(100)
  noShowCount Int       @default(0)
  bannedUntil DateTime?

  createdAt DateTime @default(now())

  experiments  Experiment[]
  appointments Appointment[]
  creditEvents CreditEvent[]
  chatSessions ChatSession[]
  assistantThreads AssistantThread[]

  // 私信：被试发起、主试接收
  threadsAsSubject    DirectThread[] @relation("ThreadSubject")
  threadsAsResearcher DirectThread[] @relation("ThreadResearcher")
  directMessages      DirectMessage[]

  notifications Notification[]
  questionnaireResponses QuestionnaireResponse[]

  @@index([role])
}

model Experiment {
  id           String @id @default(cuid())
  researcherId String
  title        String
  description  String
  location     String
  durationMin  Int
  rewardText   String
  type         String @default("INDIVIDUAL") // ExperimentType
  /// 实验形态：OFFLINE 到实验室，ONLINE 线上完成（问卷即实验，不排时段）
  mode         String @default("OFFLINE") // ExperimentMode
  /// 是否需要先填问卷。线上实验恒为 true；线下由主试勾选
  needsQuestionnaire Boolean @default(false)
  /// 线上实验选「全时段可填写」：不设截止时间。
  /// 库里的 signupDeadline 会写一个远期哨兵值（domain 的 OPEN_ANYTIME_DEADLINE），
  /// 这样所有「未截止」的过滤条件保持一种写法，页面按这个标记改文案即可
  openAnytime  Boolean @default(false)
  groupSize    Int?
  requirements String?
  minCreditScore Int  @default(0)
  needsVerification Boolean @default(true)
  signupDeadline DateTime
  status       String @default("DRAFT") // ExperimentStatus
  createdAt    DateTime @default(now())

  researcher User @relation(fields: [researcherId], references: [id], onDelete: Cascade)
  slots      Slot[]
  appointments Appointment[]
  chatSessions ChatSession[]
  questionnaire Questionnaire?

  @@index([status, signupDeadline])
  @@index([mode, status])
}

model Slot {
  id           String   @id @default(cuid())
  experimentId String
  startAt      DateTime
  endAt        DateTime
  capacity     Int      @default(1)
  bookedCount  Int      @default(0)

  experiment   Experiment    @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([experimentId, startAt])
  @@index([experimentId, startAt])
}

model Appointment {
  id           String @id @default(cuid())
  experimentId String
  slotId       String
  subjectId    String
  status       String @default("PENDING_SUBJECT_CONFIRM") // AppointmentStatus
  createdAt    DateTime @default(now())
  confirmedAt  DateTime?
  checkedInAt  DateTime?
  noShowAt     DateTime?

  // 申诉
  appealStatus     String? // null | PENDING | UPHELD | REJECTED
  appealAt         DateTime?
  appealResolvedAt DateTime?
  appealNote       String?

  // 主试处理提醒（定时任务写入）
  remindedAt   DateTime?

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  slot       Slot       @relation(fields: [slotId], references: [id], onDelete: Cascade)
  subject    User       @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([slotId, subjectId])
  @@index([subjectId, status])
  @@index([experimentId, status])
}

/// 站内通知。
///
/// 提醒类通知由定时任务生成：代码决定「何时、给谁、哪一档」，
/// 内容由模型生成（失败时用模板兜底）。
///
/// `(appointmentId, level)` 唯一 —— 幂等唯一手段。
/// 不靠「记住发过没有」，靠数据库拒绝重复。
/// 这样即使服务停了半小时，恢复后补推也不会重复。
model Notification {
  id            String @id @default(cuid())
  userId        String
  kind          String @default("REMINDER") // NotificationKind
  /// 提醒档位：H3 / H1 / M10；非提醒类为 null
  level         String?
  appointmentId String?
  experimentId  String?
  content       String
  /// 预留投递通道，当前恒为 IN_APP
  channel       String    @default("IN_APP")
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, level])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model ChatSession {
  id           String @id @default(cuid())
  experimentId String
  subjectId    String
  state        String @default("COLLECTING_AVAILABILITY")
  messages     String @default("[]") // JSON 字符串
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  subject    User       @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([experimentId, subjectId])
}

// ── 实验助手的跨实验会话（「门厅」）────────────────
// 与 ChatSession 的分工：
//   ChatSession    = 一门实验内的排期对话（有 experimentId，有状态机，能下单）
//   AssistantThread = 还不知道是哪门实验时的找实验对话（只有消息，没有状态机）
//
// 为什么不给 ChatSession 的 experimentId 改成可空：那会让「一 session 一实验」的语义被稀释，
// 老代码里所有 `session.experimentId` 的读取都要重新想一遍——而它们的语义并没有变。
model AssistantThread {
  id        String   @id @default(cuid())
  subjectId String
  messages  String   @default("[]") // JSON 字符串，折叠态（tool result 挂在 assistant 上）
  // ── 会话化（一个被试可以有很多条，任意时刻至多一条活会话）────────
  // 没有 status 枚举：endedAt === null 就是活的。加枚举是重复表达，
  // 而且「软结束可复活」用一个字段表达不了（要靠 outcome 之外的东西）。
  messageCount Int       @default(0) // 压缩前的条数，审计用（messages 会被压缩变短）
  summary      String? // 第 2 层压缩产物：结构化条件 + 梗概。null = 还没压过
  outcome      String? // SessionEndReason
  outcomeRef   String? // 产生的业务结果 id（如 appointmentId），用于追溯
  endedAt      DateTime? // null = 活会话
  // 「软结束」（用户说"我再看看"）不是结束，只是下次说话要显式复活。
  // 单开一列而不是塞进 outcome：outcome 记的是「为什么结束」，把 SEALED 塞进去
  // 会让「这条是不是结束了」要靠解析字符串，而查询条件里最需要的正是这个布尔。
  sealedAt     DateTime?
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  subject User @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  // 拆掉 @@unique([subjectId]) —— 那正是「一人一条永不更换」的根源。
  // 换成「按人 + 最近活跃」的索引，取活会话 / 列出历史都走它。
  @@index([subjectId, lastActiveAt])
}

model CreditEvent {
  id            String   @id @default(cuid())
  userId        String
  delta         Int
  reason        String // CreditReason
  appointmentId String?
  note          String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// 登录验证码 / 教育邮箱验证码。开发环境统一 123456（邮箱为 6 位随机并打印到控制台）。
model VerifyCode {
  id        String   @id @default(cuid())
  target    String // 手机号 或 邮箱
  purpose   String // LOGIN | EDU_EMAIL
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([target, purpose])
}

// ── 被试 ↔ 主试 私信 ─────────────────────────────
// 一个人跟同一个主试只开一条线程（unique），从哪个实验发起的记在 experimentId 上。
model DirectThread {
  id           String  @id @default(cuid())
  subjectId    String
  researcherId String
  experimentId String?

  createdAt     DateTime  @default(now())
  lastMessageAt DateTime?

  subject    User            @relation("ThreadSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  researcher User            @relation("ThreadResearcher", fields: [researcherId], references: [id], onDelete: Cascade)
  messages   DirectMessage[]

  @@unique([subjectId, researcherId])
  @@index([researcherId, lastMessageAt])
  @@index([subjectId, lastMessageAt])
}

model DirectMessage {
  id       String @id @default(cuid())
  threadId String
  senderId String
  content  String

  createdAt DateTime @default(now())
  readAt    DateTime?

  thread DirectThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// ── 实验问卷 ─────────────────────────────────────
// 一门实验最多一份问卷（experimentId unique）。
// 题目与答案都用 TEXT 存 JSON —— 与 ChatSession.messages 同一套约定，
// SQLite 不支持 Json 字段，读写一律走 domain/questionnaire.ts 的 helper。
model Questionnaire {
  id           String  @id @default(cuid())
  experimentId String  @unique
  title        String
  intro        String?
  /// DRAFT 只有主试能看；PUBLISHED 被试才能填
  status       String  @default("DRAFT")
  /// 主试写的评分要求（自然语言），给计分 agent 当评分标准
  scoringRule  String?
  /// 通过线。null = 不做分数筛选
  passScore    Int?
  /// 从上传文件里解析出的原文，保留用于「重新生成」
  sourceText   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  experiment Experiment              @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  questions  Question[]
  responses  QuestionnaireResponse[]

  @@index([status])
}

model Question {
  id              String  @id @default(cuid())
  questionnaireId String
  /// 展示顺序，从 0 开始
  order           Int
  /// SINGLE | MULTI | SCALE | TEXT
  type            String
  title           String
  required        Boolean @default(true)
  /// 选择题的选项，JSON: ["选项A","选项B"]；非选择题为 null
  options         String?
  scaleMin        Int?
  scaleMax        Int?

  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@index([questionnaireId, order])
}

/// 一份答卷。
/// `(questionnaireId, subjectId)` 唯一 —— 同一人重复提交是「覆盖」而不是新增，
/// 与报名一样的幂等思路：靠数据库约束，不靠应用层查一遍。
model QuestionnaireResponse {
  id              String   @id @default(cuid())
  questionnaireId String
  subjectId       String
  /// JSON: { [questionId]: string | string[] | number }
  answers         String
  /// null = 还没算分（模型不可用或未触发）
  score           Int?
  scoreReason     String?
  /// null = 未判定；true/false 由计分结果或主试手动改
  passed          Boolean?
  /// SUBMITTED | SCORED | INVITED
  status          String   @default("SUBMITTED")
  submittedAt     DateTime @default(now())
  scoredAt        DateTime?
  invitedAt       DateTime?
  /// 已把「本轮条件不匹配」告知被试的时间。与 invitedAt 对称，两者互斥
  declinedAt      DateTime?

  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  subject       User          @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([questionnaireId, subjectId])
  @@index([questionnaireId, score])
}

