# 这个文件会被自动复制成 .env：`npm run setup` / `npm run dev` / `npm start`
# 和双击的启动脚本都会先跑 scripts/ensure-env.mjs，没有 .env 就照这份抄一份。
# 所以从 GitHub 下载后**不用手动创建 .env**，保持这份模板可用就行。
# 要改配置，改的是生成出来的 .env（它不会进仓库）。

# ---- 数据库 ----
# 本地开发：SQLite 文件（零安装）
DATABASE_URL="file:./dev.db"
# 换用其他数据库的步骤见 README「部署到服务器」一节

# ---- 认证 ----
JWT_SECRET="dev-only-change-me-access-secret-please"
JWT_REFRESH_SECRET="dev-only-change-me-refresh-secret-please"

# ---- LLM（OpenAI 兼容接口，DeepSeek）----
LLM_BASE_URL="https://api.deepseek.com"
LLM_API_KEY=""
LLM_MODEL="deepseek-chat"

# ---- 学生认证 ----
EDU_EMAIL_DOMAINS="edu.cn,edu"

# ---- 邮件（开发环境用 mock：验证码打到控制台 + mock-email.log）----
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# ---- 自测用 ----
# 设为 true 才会开放 /api/dev/login?phone=...&to=...（一键登录，给截图脚本用）
# 默认不设，接口直接 404；线上千万不要打开
ENABLE_DEV_LOGIN=""
