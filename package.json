{
  "name": "psymatch",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-env.mjs && node scripts/next-run.mjs dev -p 3000",
    "build": "node scripts/ensure-env.mjs && prisma generate && node scripts/next-run.mjs build --turbopack",
    "start": "node scripts/ensure-env.mjs && node scripts/prepare-db.mjs && node scripts/build-if-needed.mjs && node scripts/next-run.mjs start",
    "db:push": "node scripts/ensure-env.mjs && prisma db push",
    "db:seed": "node scripts/ensure-env.mjs && tsx prisma/seed.ts",
    "db:reset": "node scripts/ensure-env.mjs && prisma db push --force-reset && tsx prisma/seed.ts",
    "setup": "node scripts/ensure-env.mjs && prisma generate && prisma db push && tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "accept": "tsx scripts/acceptance.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@tanstack/react-query": "^5.62.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
